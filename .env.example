# MacroChef Environment Configuration (Example)
# Copy to .env.local and fill with your actual values

# ============================================================
# SUPABASE CONFIGURATION
# ============================================================

# Production Supabase Instance
# Get from: https://app.supabase.com/macrochef-prod → Settings → API
SUPABASE_PROD_SERVICE_KEY=sb_prod_svc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_PROD_URL=https://xymudnmqahgayqvpznwz.supabase.co

# Test/Development Supabase Instance
# Get from: https://app.supabase.com/macrochef-test → Settings → API
SUPABASE_TEST_SERVICE_KEY=sb_test_svc_xxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SUPABASE_TEST_URL=https://pcjlrcuyhtqoijtkrlyj.supabase.co

# ============================================================
# BUILD CONFIGURATION
# ============================================================

NODE_ENV=development
# NODE_ENV=production

# ============================================================
# DATABASE BACKUP CONFIGURATION (Optional)
# ============================================================

# For database backup scripts
# DB_BACKUP_DIR=./backups
# DB_BACKUP_RETENTION_DAYS=30

# ============================================================
# NOTES
# ============================================================
#
# 1. NEVER commit this file with real secrets to git!
#    Use .env.local (gitignored) for local development.
#
# 2. Service Keys are sensitive - keep them private!
#    - Anon Key: Safe to use in browser
#    - Service Role Secret: Only for backend/server scripts
#
# 3. To get Service Keys:
#    a. Go to https://app.supabase.com/
#    b. Select your project
#    c. Settings → API
#    d. Copy "Service Role Secret" (scroll down)
#
# 4. For CI/CD (GitHub Actions), add secrets via:
#    Repository Settings → Secrets and variables → Actions
#
# 5. Environment detection in app:
#    - FILE protocol = LOCAL mode (no Supabase)
#    - localhost/127.0.0.1 = TEST
#    - macrochef.pl = PROD
#    - test.macrochef.pl = TEST
