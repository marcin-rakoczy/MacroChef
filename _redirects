/*
  MacroChef SPA Routing Rules for Cloudflare Pages
  Purpose: Route all SPA navigation to index.html (client-side routing)
  Note: This file is automatically used by Cloudflare Pages for routing rules
*/

# Serve index.html for root path
/ /index.html 200

# Serve index.html for all routes (SPA client-side routing)
/* /index.html 200

# Don't rewrite actual static files
/dist/* :splat 200
/assets/* :splat 200
/sw.js /sw.js 200
/CNAME /CNAME 200
